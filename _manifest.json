{
  "manifest_version": 2,
  "id": "omsociety.schedule-assistant",
  "version": "2.0.0",
  "name": "日程提醒助手",
  "description": "贴心日程管家：早安播报、习惯提醒、日程管理与提醒，全部推送交给 Maisaka 主动发起",
  "author": {
    "name": "OMSociety",
    "url": "https://github.com/OMSociety"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/OMSociety/maibot_plugin_schedule_assistant",
    "homepage": "https://github.com/OMSociety/maibot_plugin_schedule_assistant",
    "documentation": "https://github.com/OMSociety/maibot_plugin_schedule_assistant#readme",
    "issues": "https://github.com/OMSociety/maibot_plugin_schedule_assistant/issues"
  },
  "host_application": {
    "min_version": "1.4.5",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.23.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "apscheduler",
      "version_spec": ">=3.10.0,<4.0.0"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    },
    {
      "type": "python_package",
      "name": "python-dateutil",
      "version_spec": ">=2.8.0"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "logo.png",
      "fallback": "package"
    }
  },
  "capabilities": ["chat.get_stream_by_user_id", "maisaka.proactive.trigger"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN", "en-US", "ja-JP"]
  }
}
