{
  "manifest_version": 2,
  "id": "omsociety.schedule-assistant",
  "version": "1.0.0",
  "name": "日程提醒助手",
  "description": "贴心日程管家，支持早安播报、习惯提醒、LLM 智能日程管理、Apple 日历双向同步、Notion 待办同步",
  "author": {
    "name": "OMSociety",
    "url": "https://github.com/OMSociety"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/OMSociety/maibot_plugin_schedule_assistant"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "apscheduler",
      "version_spec": ">=3.10.0,<4.0.0"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    },
    {
      "type": "python_package",
      "name": "python-dateutil",
      "version_spec": ">=2.8.0"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "logo.png",
      "fallback": "package"
    }
  },
  "capabilities": ["send.text", "send.custom", "chat.get_stream_by_user_id", "maisaka.proactive.trigger", "llm.generate", "config.get"],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
